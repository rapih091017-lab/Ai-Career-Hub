# ─── Database ─────────────────────────────────────────────
# PostgreSQL connection string untuk Drizzle ORM
DATABASE_URL=postgresql://user:pass@host:5432/ai_career_hub

# ─── NextAuth.js ──────────────────────────────────────────
# Generate dengan: openssl rand -base64 32
AUTH_SECRET=generate-dengan-openssl-rand-base64-32
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# ─── Midtrans Payment ─────────────────────────────────────
# Dapatkan dari Dashboard Midtrans (https://dashboard.midtrans.com)
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_IS_PRODUCTION=false

# ─── AI / DeepSeek ────────────────────────────────────────
# Dapatkan dari https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# Optional: OpenAI-compatible base URL (default: https://api.deepseek.com/v1)
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ─── Admin Access ─────────────────────────────────────────
# Daftar email yang dapat mengakses halaman admin (pisahkan dengan koma)
# Contoh: admin1@gmail.com,admin2@gmail.com
ADMIN_EMAILS=

# ─── Public URL ───────────────────────────────────────────
# Ganti dengan URL production nanti (Render / Vercel / Railway)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
