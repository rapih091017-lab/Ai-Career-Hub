{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "git": {
    "deploymentEnabled": {
      "master": true
    }
  },
  "regions": ["sin1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "src/app/api/export-pdf-v2/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/cv-documents/[id]/pdf/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/pdf-test-save/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cv/new",
      "destination": "/builder/new",
      "permanent": true
    }
  ]
}