# PDF Server Configuration
# Copy this file to .env and adjust values for your environment.

# Port for the PDF server to listen on
PDF_SERVER_PORT=3001

# Railway automatically sets PUPPETEER_EXECUTABLE_PATH via nixpacks.toml
# For local dev, leave this empty — Puppeteer will use its bundled Chromium.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Railway sets this automatically for container networking
# RAILWAY_PUBLIC_DOMAIN=your-app.railway.app
